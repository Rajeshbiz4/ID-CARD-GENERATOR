# Add these in Vercel -> Backend Project -> Settings -> Environment Variables.
# Do not commit your real credentials.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-production-secret
CLIENT_URL=https://YOUR-FRONTEND-PROJECT.vercel.app

# Optional: allow *.vercel.app preview deployment origins.
# Set to false for the strictest production setup.
ALLOW_VERCEL_PREVIEWS=false
